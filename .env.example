# 이 파일을 .env 로 복사한 뒤 값을 채운다. (.env 는 커밋 금지)
#   cp .env.example .env

# --- Database (docker-compose 와 애플리케이션이 함께 사용) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=puppy_kindergarten
DB_USERNAME=
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Kakao 로그인 (https://developers.kakao.com 내 애플리케이션) ---
# [앱] > [플랫폼 키] > [REST API 키] 의 REST API 키
KAKAO_CLIENT_ID=
# 같은 화면의 클라이언트 시크릿 코드
KAKAO_CLIENT_SECRET=

# --- 역할 ---
# 원장(ROLE_DIRECTOR)으로 지정할 카카오 회원번호. 쉼표 구분. 비우면 모든 사용자가 견주(ROLE_OWNER).
DIRECTOR_KAKAO_IDS=

# --- JWT ---
# HS256 서명키. Base64 인코딩된 32바이트 이상 값.  생성: openssl rand -base64 32
JWT_SECRET=
# 아래는 선택 (기본값: Access 15분, Refresh 14일)
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=14d
