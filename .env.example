# 이 파일을 .env 로 복사한 뒤 값을 채운다. (.env 는 커밋 금지)
#   cp .env.example .env

# --- Database (docker-compose 와 애플리케이션이 함께 사용) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=puppy_kindergarten
DB_USERNAME=
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Kakao 로그인 (https://developers.kakao.com 내 애플리케이션) ---
# REST API 키
KAKAO_CLIENT_ID=
# 카카오 로그인 > 보안 > Client Secret
KAKAO_CLIENT_SECRET=

# --- 역할 ---
# 원장(ROLE_DIRECTOR)으로 지정할 카카오 회원번호. 쉼표 구분. 비우면 모든 사용자가 견주(ROLE_OWNER).
DIRECTOR_KAKAO_IDS=
